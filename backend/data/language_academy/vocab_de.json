  "grammar_basics": [
    {
      "title": "Noun Gender",
      "explanation": "German nouns have three genders: masculine (der), feminine (die), and neuter (das). The gender must be memorised for each noun.",
      "examples": ["der Mann (the man)", "die Frau (the woman)", "das Kind (the child)"]
    },
    {
      "title": "Verb Conjugation",
      "explanation": "German verbs change their endings to match the subject. For 'spielen' (to play): ich spiele, du spielst, er/sie spielt, wir spielen, ihr spielt, sie spielen.",
      "examples": ["Ich spiele Fußball. (I play football.)", "Er spielt Gitarre. (He plays guitar.)"]
    },
    {
      "title": "Word Order",
      "explanation": "In German, the verb must come second in a main sentence. Time expressions often come before the subject.",
      "examples": ["Ich gehe heute in die Schule. (I go to school today.)", "Heute gehe ich in die Schule. (Today I go to school.)"]
    },
    {
      "title": "Umlauts",
      "explanation": "German has three special vowels with umlauts: ä (like 'e' in 'bed'), ö (like 'u' in 'burn'), ü (like French 'u'). Also ß = 'ss'.",
      "examples": ["Mädchen (girl)", "schön (beautiful)", "grün (green)", "Straße (street)"]
    }
