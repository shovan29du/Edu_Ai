  "grammar_basics": [
    {
      "title": "Noun Gender",
      "explanation": "Italian nouns are either masculine or feminine. Masculine nouns usually end in -o, feminine in -a. The articles are: il/lo (masc.), la (fem.), l' before vowels.",
      "examples": ["il libro (the book - masc.)", "la scuola (the school - fem.)", "l'amico (the friend)"]
    },
    {
      "title": "Plural Forms",
      "explanation": "Most Italian nouns change their ending to form the plural. Masculine -o → -i; feminine -a → -e.",
      "examples": ["il libro → i libri (books)", "la scuola → le scuole (schools)", "la pizza → le pizze (pizzas)"]
    },
    {
      "title": "Verb Endings",
      "explanation": "Italian verbs are conjugated by subject. For 'parlare' (to speak): io parlo, tu parli, lui/lei parla, noi parliamo, voi parlate, loro parlano.",
      "examples": ["Io parlo italiano. (I speak Italian.)", "Noi mangiamo pizza. (We eat pizza.)"]
    },
    {
      "title": "Adjective Agreement",
      "explanation": "Adjectives must agree in gender and number with the noun they describe.",
      "examples": ["il gatto nero (the black cat)", "la casa rossa (the red house)", "i gatti neri (the black cats)"]
    }
  ],
