  "grammar_basics": [
    {
      "title": "Arabic Script",
      "explanation": "Arabic is written right to left. There are 28 letters, each with up to 4 forms depending on position (beginning, middle, end, or alone). Short vowels are shown by small marks (harakat) above or below letters."
    },
    {
      "title": "Definite Article",
      "explanation": "Arabic has only one definite article: 'al-' (ال), meaning 'the'. Example: kitab = a book; al-kitab = the book. This is different from English which has both 'a' and 'the'."
    },
    {
      "title": "Dual and Plural",
      "explanation": "Arabic has singular, dual (exactly 2), and plural forms. For two items, add '-ayn': kitabayn (two books). Plurals are often irregular and must be memorised."
    },
    {
      "title": "Gender",
      "explanation": "Arabic nouns are masculine or feminine. Feminine nouns often end in 'ta marbuta' (ة). Example: mu'allim (male teacher), mu'allima (female teacher)."
    },
    {
      "title": "Verb Position",
      "explanation": "In Arabic, the verb often comes before the subject: 'Dhahaba Ahmad' = 'Ahmad went' (literally: 'Went Ahmad'). This is called VSO (Verb-Subject-Object) order."
    }
  ],
