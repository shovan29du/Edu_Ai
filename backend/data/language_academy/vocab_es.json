  "grammar_basics": [
    {
      "title": "Nouns and Gender",
      "explanation": "Spanish nouns are masculine or feminine. Masculine nouns usually end in -o (el libro, the book); feminine nouns usually end in -a (la mesa, the table). Articles: el/un (masc.), la/una (fem.)."
    },
    {
      "title": "Ser vs. Estar",
      "explanation": "Spanish has two verbs meaning 'to be'. Use 'ser' for permanent characteristics (I am tall, I am Spanish). Use 'estar' for temporary states (I am tired, I am in Madrid)."
    },
    {
      "title": "Present Tense -AR Verbs",
      "explanation": "Regular -ar verbs: hablar (to speak) → yo hablo, tú hablas, él/ella habla, nosotros hablamos, vosotros habláis, ellos/ellas hablan."
    },
    {
      "title": "Negation",
      "explanation": "Place 'no' before the verb: Hablo inglés → No hablo inglés. (I speak English → I don't speak English.)"
    },
    {
      "title": "Questions",
      "explanation": "Spanish questions use inverted question marks: ¿Hablas español? Note that subject pronouns are often dropped: 'Hablas español?' is perfectly fine."
    }
  ],
