  "grammar_basics": [
    {
      "title": "Nouns and Gender",
      "explanation": "Every French noun is either masculine (le/un) or feminine (la/une). For example: le livre (the book - masculine), la table (the table - feminine). The gender must be memorised with each word."
    },
    {
      "title": "Plural",
      "explanation": "Most French nouns add -s in the plural, but it is usually silent: un livre → des livres. Words ending in -eau add -x: bateau → bateaux."
    },
    {
      "title": "Present Tense -ER Verbs",
      "explanation": "Regular -er verbs follow a pattern. Take parler (to speak): je parle, tu parles, il/elle parle, nous parlons, vous parlez, ils/elles parlent."
    },
    {
      "title": "Negation",
      "explanation": "To make a sentence negative, put ne...pas around the verb: Je parle → Je ne parle pas. (I speak → I don't speak.)"
    },
    {
      "title": "Questions",
      "explanation": "Three ways to ask questions: 1) Rising intonation: Tu parles français? 2) Est-ce que: Est-ce que tu parles français? 3) Inversion: Parles-tu français?"
    }
  ],
