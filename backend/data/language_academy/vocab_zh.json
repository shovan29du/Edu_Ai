  "grammar_basics": [
    {
      "title": "Tones",
      "explanation": "Mandarin has 4 tones (plus a neutral tone). The same syllable with different tones has completely different meanings. For example, 'mā' (妈, mother), 'má' (麻, hemp), 'mǎ' (马, horse), 'mà' (骂, to scold).",
      "examples": ["First tone (ā): flat and high — 妈 (mā = mother)", "Second tone (á): rising — 马 (má)", "Third tone (ǎ): dip then rise — 马 (mǎ = horse)", "Fourth tone (à): falling — 骂 (mà = to scold)"]
    },
    {
      "title": "No Verb Conjugation",
      "explanation": "Mandarin verbs do not change form. There is no past/present/future conjugation. Time words and context show tense.",
      "examples": ["我吃 (wǒ chī) = I eat", "我昨天吃 (wǒ zuótiān chī) = I ate yesterday", "我明天吃 (wǒ míngtiān chī) = I will eat tomorrow"]
    },
    {
      "title": "Measure Words",
      "explanation": "When counting nouns, a measure word must be used between the number and the noun. Different nouns use different measure words.",
      "examples": ["一本书 (yī běn shū) = one book ('běn' for books)", "三个苹果 (sān gè píngguǒ) = three apples ('gè' is the most common)"]
    },
    {
      "title": "Characters",
      "explanation": "Chinese is written in characters (汉字, Hànzì). Each character represents a syllable and has meaning. There are thousands of characters, but knowing about 2000 is enough for daily reading.",
      "examples": ["日 (rì) = sun/day", "月 (yuè) = moon/month", "明 (míng) = bright (sun + moon together)"]
    }
  ],
