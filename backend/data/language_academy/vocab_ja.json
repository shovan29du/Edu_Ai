  "grammar_basics": [
    {
      "title": "Three Writing Systems",
      "explanation": "Japanese uses three scripts together: Hiragana (46 syllable characters for native words), Katakana (46 for foreign words), and Kanji (Chinese-origin characters). Most texts use all three.",
      "examples": ["Hiragana: あいうえお (a-i-u-e-o)", "Katakana: アイウエオ (same sounds, for foreign words)", "Kanji: 山 (yama = mountain), 川 (kawa = river)"]
    },
    {
      "title": "Sentence Order: SOV",
      "explanation": "Japanese sentence order is Subject-Object-Verb. The verb always comes at the END of the sentence.",
      "examples": ["Watashi wa ringo wo tabemasu. = I apple eat. (I eat an apple.)", "Sensei wa hon wo yomimasu. = Teacher book reads. (The teacher reads a book.)"]
    },
    {
      "title": "Particles",
      "explanation": "Particles are small words added after nouns to show their role. は (wa) marks the topic, が (ga) marks the subject, を (wo) marks the object, に (ni) marks direction/location.",
      "examples": ["わたしは (watashi wa) = as for me / I", "りんごを (ringo wo) = apple (object)", "がっこうに (gakkou ni) = to school"]
    },
    {
      "title": "Politeness Levels",
      "explanation": "Japanese has formal and informal speech. Formal speech adds -masu to verbs and uses -desu with nouns. Informal speech drops these endings. Always use formal Japanese with teachers and elders.",
      "examples": ["Formal: 食べます (tabemasu = eat)", "Informal: 食べる (taberu = eat)"]
    }
  ],
